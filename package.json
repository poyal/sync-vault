{
  "name": "sync-vault",
  "version": "0.1.1",
  "description": "개인 LAN 클립보드 및 파일 공유",
  "author": "Sync Vault",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "check": "tsc --noEmit && npm test",
    "dist:dev": "node scripts/build.mjs --dev && node scripts/package.mjs --dev",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node scripts/test.mjs",
    "test:e2e": "npm run build && node tests/desktop.mjs && node tests/user-journeys.mjs && node tests/storage-journeys.mjs",
    "dist:win": "npm run build && node scripts/package.mjs",
    "dist:mac": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@peculiar/x509": "2.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "bonjour-service": "1.4.4",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "reflect-metadata": "0.2.2",
    "zod": "4.6.7",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "io.syncvault.desktop",
    "productName": "Sync Vault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/native",
        "to": "native"
      }
    ],
    "npmRebuild": false,
    "artifactName": "SyncVault-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "등록한 내 기기와 클립보드 및 파일을 공유합니다.",
        "NSBonjourServices": [
          "_sync-vault._tcp"
        ]
      }
    },
    "publish": null
  }
}
